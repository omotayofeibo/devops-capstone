
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                    java -version
                    git --version
                    mvn -version
                '''
            }
        }

        stage('Build Java Application') {
            steps {
                dir('java') {
                    sh 'mvn -B clean package'
                }
            }
        }
    }

    post {
        success {
            echo 'Java application built successfully!'
        }

        failure {
            echo 'Pipeline failed. Check console output.'
        }
    }
}
